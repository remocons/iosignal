{
  "compilerOptions": {
    "declaration": true,
    "preserveSymlinks": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "allowJs": true,
    "module": "nodenext",    
    "moduleResolution": "nodenext",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "paths": {
      "@src/*": ["./src/*"]
    }
  },
  "include": [
    "src/client/browser/IOWebSocket.js",
    "src/client/IOCore.js",
    "src/common/constants.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}