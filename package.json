{
  "name": "iosignal",
  "version": "10.1.0",
  "description": "iosignal",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node/iosignal.d.ts",
        "default": "./dist/node/iosignal.js"
      },
      "require": {
        "types": "./dist/node/iosignal.d.cts",
        "default": "./dist/node/iosignal.cjs"
      }
    },
    "./io": {
      "types": "./dist/browser/esm/io.d.ts",
      "default": "./dist/browser/esm/io.js"
    },
    "./io.js": {
      "types": "./dist/browser/esm/io.d.ts",
      "default": "./dist/browser/esm/io.js"
    },
    "./broker": "./dist/browser/esm/broker.js",
    "./browser/*": "./dist/browser/*",
    "./devices": "./dist/devices/shared/index.js",
    "./devices/*": "./dist/devices/*"
  },
  "types": "./dist/node/iosignal.d.ts",
  "jsdelivr": "./dist/browser/iife/io.js",
  "unpkg": "./dist/browser/iife/io.js",
  "scripts": {
    "build": "rollup -c && npm run build:types && node scripts/devices.mjs",
    "build:types": "tsc --project tsconfig.json",
    "test": "node --test --test-timeout=30000 checks/*.test.mjs test/integration/*.test.mjs test/devices/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run verify",
    "test:integration": "node --test --test-timeout=15000 test/integration/*.test.mjs"
  },
  "author": {
    "name": "Taeo Lee",
    "email": "sixgen@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.1.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "boho": "^3.0.1",
    "eventemitter3": "^5.0.4",
    "meta-buffer-pack": "^2.1.3",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remocons/iosignal.git"
  },
  "keywords": [
    "websocket",
    "pubsub",
    "messaging",
    "real-time",
    "signaling",
    "signal",
    "client-server",
    "nodejs",
    "browser",
    "iot",
    "arduino",
    "auth"
  ],
  "files": [
    "dist/browser/esm/broker.js",
    "dist/browser/esm/broker.js.map",
    "dist/browser/esm/io.d.ts",
    "dist/browser/esm/io.js",
    "dist/browser/esm/io.js.map",
    "dist/browser/iife/io.js",
    "dist/browser/iife/io.js.map",
    "dist/node/iosignal.cjs",
    "dist/node/iosignal.d.cts",
    "dist/node/iosignal.d.ts",
    "dist/node/iosignal.js",
    "dist/types/client/IOCore.d.ts",
    "dist/types/client/browser/IOWebSocket.d.ts",
    "dist/types/common/constants.d.ts",
    "dist/types/common/payload.d.ts",
    "dist/devices/components/iosignal-devices.js",
    "dist/devices/components/iosignal-link.js",
    "dist/devices/components/tokens.css.js",
    "dist/devices/components/vdevice-view.js",
    "dist/devices/components/widgets.js",
    "dist/devices/conformance/device-rules.json",
    "dist/devices/examples/blind.device.js",
    "dist/devices/examples/doorbell.device.json",
    "dist/devices/examples/fan.device.js",
    "dist/devices/examples/group-led.device.js",
    "dist/devices/examples/lamp.device.js",
    "dist/devices/examples/relay4.device.json",
    "dist/devices/examples/thermo.device.js",
    "dist/devices/runner/device-runner.js",
    "dist/devices/runner/lib.js",
    "dist/devices/shared/command.js",
    "dist/devices/shared/discovery.js",
    "dist/devices/shared/e2eSession.js",
    "dist/devices/shared/index.js",
    "dist/devices/shared/media.js",
    "dist/devices/shared/schema.js",
    "dist/devices/shared/simulate.js",
    "dist/devices/shared/state.js",
    "dist/devices/shared/typeName.js",
    "dist/devices/shared/view.js",
    "dist/devices/types/camera-session.1.json",
    "dist/devices/types/camera.1.json",
    "dist/devices/types/dimmer.1.json",
    "dist/devices/types/fan.1.json",
    "dist/devices/types/index.json",
    "dist/devices/types/iris.1.json",
    "dist/devices/types/iris.2.json",
    "dist/devices/types/light.1.json",
    "dist/devices/types/media-remote.1.json",
    "dist/devices/types/relay4.1.json",
    "dist/devices/types/rgb-light.1.json",
    "dist/devices/types/switch2.1.json",
    "dist/devices/types/switch3.1.json",
    "dist/devices/types/switch4.1.json",
    "dist/devices/types/switch8.1.json",
    "dist/devices/types/thermo-hygrometer.1.json"
  ]
}
