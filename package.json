{
  "name": "iosignal",
  "version": "5.2.0",
  "description": "iosignal",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/node/iosignal.js",
      "require": "./dist/node/iosignal.cjs"
    },
    "./io": "./dist/browser/esm/io.js",
    "./io.js": "./dist/browser/esm/io.js",
    "./browser/*": "./dist/browser/*"
  },
  "types": "./dist/types/client/browser/IOWebSocket.d.ts",
  "jsdelivr": "./dist/browser/iife/io.js",
  "unpkg": "./dist/browser/iife/io.js",
  "scripts": {
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc --project tsconfig.json"
  },
  "author": {
    "name": "Taeo Lee",
    "email": "sixgen@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.1.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "boho": "^2.1.3",
    "eventemitter3": "^5.0.4",
    "meta-buffer-pack": "^2.1.3",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remocons/iosignal.git",
    "directory": "packages/iosignal"
  },
  "keywords": [
    "websocket",
    "pubsub",
    "messaging",
    "real-time",
    "signaling",
    "signal",
    "client-server",
    "nodejs",
    "browser",
    "iot",
    "arduino",
    "auth"
